{
  "name": "@manifest-network/ics23",
  "version": "0.6.9",
  "description": "Manifest-maintained ICS23 proof verification with patched protobufjs dependencies",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manifest-network/cosmjs.git",
    "directory": "vendor/ics23/js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Ethan Frey",
  "license": "Apache-2.0",
  "private": false,
  "files": [
    "build/**",
    "!build/**/*.spec.*",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "scripts": {
    "lint": "eslint --max-warnings 0 './src/**/*.ts'",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write --loglevel warn \"./src/**/*.ts\"",
    "test": "npm run build && node jasmine-testrunner.js",
    "build": "node scripts/build.cjs",
    "pack-proto": "pbjs -t static-module -w commonjs -o src/generated/codecimpl.js ../proofs.proto",
    "define-proto": "pbts src/generated/codecimpl.js -o src/generated/codecimpl.d.ts",
    "protoc": "yarn pack-proto && yarn define-proto && yarn format",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/jasmine": "^3.5.0",
    "@typescript-eslint/eslint-plugin": "^5.10.2",
    "@typescript-eslint/parser": "^5.10.2",
    "eslint": "^8.8.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "jasmine": "^3.5.0",
    "jasmine-console-reporter": "^3.1.0",
    "prettier": "^2.5.1",
    "shx": "^0.3.4",
    "source-map-support": "^0.5.16",
    "typescript": "5.9.3",
    "@types/node": "22.20.1"
  },
  "dependencies": {
    "@noble/hashes": "^1.0.0",
    "protobufjs": "^7.6.5"
  }
}
